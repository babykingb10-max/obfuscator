# Port the API listens on (Heroku/Pterodactyl set this automatically via $PORT)
PORT=4000

# Comma-separated list of origins allowed to call this API (your Vercel frontend URL)
ALLOWED_ORIGINS=https://your-frontend.vercel.app,http://localhost:3000

# Reserved for future account/history features -- never commit real values
DATABASE_URL=
JWT_SECRET=
